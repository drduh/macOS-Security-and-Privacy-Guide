# https://github.com/drduh/macOS-Security-and-Privacy-Guide/blob/main/config/pf.rules
# Apply with: sudo pfctl -e -f pf.rules
# Show Rules: sudo pfctl -s rules
# Show State: sudo pfctl -s states
# Packet log: sudo ifconfig pflog0 create ; sudo tcpdump -ni pflog0

# Interfaces: networksetup -listallhardwareports
wifi  = "en0"
wired = "en5"
ext   = "{" $wifi $wired "}"

# Global options
set block-policy drop
set skip on lo0
set state-policy if-bound
set ruleset-optimization none

# Normalize
scrub in on $ext all fragment reassemble

# Blocklist
table <blocklist> persist

# Broadcast and multicast (IPv4)
table <broadcast> const { 224.0.0.0/4 255.255.255.255 }

# DNS servers
table <dns> const { \
  192.168.1.1 \
  8.8.4.4 8.8.8.8 \
  1.0.0.1 1.0.0.2 1.0.0.3 \
  1.1.1.1 1.1.1.2 1.1.1.3 \
  9.9.9.9 149.112.112.112 \
  9.9.9.10 149.112.112.10 \
  9.9.9.11 149.112.112.11 \
  9.9.9.12 149.112.112.12 }

table <github> const { 140.82.112.0/20 } # https://api.github.com/meta
table <router> const { 192.168.1.1 }

# DHCP
pass out quick on $ext proto udp from any port 68 to any port 67
pass in  quick on $ext proto udp from any port 67 to any port 68

# IPv6 off
block drop   in  quick inet6 all
block return out quick inet6 all

# Drop broadcast/multicast (add "log" before "quick" to monitor)
block drop quick on $ext inet to { \
  <broadcast> ($wifi:broadcast) ($wired:broadcast) }

# Drop outbound with spoofed sources
block return out log quick on $wifi  from ! ($wifi)
block return out log quick on $wired from ! ($wired)

# Deny and log everything else
block drop   in  log all
block return out log all

# Enforce blocklist
block drop   in  log quick from <blocklist>
block return out log quick to   <blocklist>

# DNS (limited to servers above)
pass out on $ext proto { tcp udp } to <dns> port { 53 853 }

# HTTP
pass out on $ext proto tcp to any port 80

# HTTPS
pass out on $ext proto { tcp udp } to any port 443

# IMAP+SMTP
pass out on $ext proto tcp to any port { 465 993 }

# WHOIS
pass out on $ext proto tcp to any port 43

# NTP
pass out on $ext proto udp to any port 123

# SSH (GitHub)
pass out on $ext proto tcp to <github> port 22

# SSH (local, wired-only)
#pass out on $wired proto tcp from ($wired) to <router> port 2400

# Outbound ICMP (ping)
#pass out on $ext proto icmp  to any
#pass out on $ext proto icmp6 to any
