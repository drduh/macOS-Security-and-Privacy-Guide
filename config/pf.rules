# https://github.com/drduh/macOS-Security-and-Privacy-Guide/blob/main/config/pf.rules
# Apply with: sudo pfctl -e -f pf.rules
# Show Rules: sudo pfctl -s rules
# Show State: sudo pfctl -s states
# Packet log: sudo ifconfig pflog0 create ; sudo tcpdump -ni pflog0

# Interfaces: networksetup -listallhardwareports
wifi  = "en0"
wired = "en5"

# Global options
set block-policy drop
set skip on lo0
set state-policy if-bound
set ruleset-optimization basic

# Normalize
scrub in on $wifi  all fragment reassemble
scrub in on $wired all fragment reassemble

# Blocklist
table <blocklist> persist

# Public DNS servers
table <resolvers> const { 192.168.1.1 \
  8.8.4.4 8.8.8.8 \
  1.0.0.1 1.0.0.2 1.0.0.3 \
  1.1.1.1 1.1.1.2 1.1.1.3 \
  9.9.9.9  149.112.112.112 \
  9.9.9.10 149.112.112.10 \
  9.9.9.11 149.112.112.11 \
  9.9.9.12 149.112.112.12 }

# SSH
table <sshGitHub> const { 140.82.112.0/20 } # https://api.github.com/meta
table <sshLocal> const { 192.168.1.1 }

# Deny and log blocked traffic
block log all

# Deny unroutable source addresses
block quick from no-route to any

antispoof quick for $wifi
antispoof quick for $wired

# Enforce blocklist
block log quick on $wifi  from <blocklist> to any
block log quick on $wifi  from any to <blocklist>
block log quick on $wired from <blocklist> to any
block log quick on $wired from any to <blocklist>

# DHCP
pass out on $wifi  proto udp from any port 68 to any port 67 keep state
pass in  on $wifi  proto udp from any port 67 to any port 68 keep state
pass out on $wired proto udp from any port 68 to any port 67 keep state
pass in  on $wired proto udp from any port 67 to any port 68 keep state

# DNS (restricted to defined resolvers)
pass out on $wifi  proto tcp from ($wifi)  to <resolvers> port 53 flags S/SA keep state
pass out on $wifi  proto udp from ($wifi)  to <resolvers> port 53 keep state
pass out on $wired proto tcp from ($wired) to <resolvers> port 53 flags S/SA keep state
pass out on $wired proto udp from ($wired) to <resolvers> port 53 keep state

# DNS-over-TLS
#pass out on $wifi  proto tcp from ($wifi)  to <resolvers> port 853 flags S/SA keep state
#pass out on $wired proto tcp from ($wired) to <resolvers> port 853 flags S/SA keep state

# HTTP
pass out on $wifi  proto tcp from ($wifi)  to any port 80 flags S/SA keep state
pass out on $wired proto tcp from ($wired) to any port 80 flags S/SA keep state

# HTTPS
pass out on $wifi  proto tcp from ($wifi)  to any port 443 flags S/SA keep state
pass out on $wifi  proto udp from ($wifi)  to any port 443 keep state
pass out on $wired proto tcp from ($wired) to any port 443 flags S/SA keep state
pass out on $wired proto udp from ($wired) to any port 443 keep state

# IMAP+SMTP
pass out on $wifi  proto tcp from ($wifi)  to any port { 465, 993 } flags S/SA keep state
pass out on $wired proto tcp from ($wired) to any port { 465, 993 } flags S/SA keep state

# WHOIS
pass out on $wifi  proto tcp from ($wifi)  to any port 43 flags S/SA keep state
pass out on $wired proto tcp from ($wired) to any port 43 flags S/SA keep state

# NTP
pass out on $wifi  proto udp from ($wifi)  to any port 123 keep state
pass out on $wired proto udp from ($wired) to any port 123 keep state

# SSH (GitHub)
pass out on $wifi  proto tcp from ($wifi)  to <sshGitHub> port 22 flags S/SA keep state
pass out on $wired proto tcp from ($wired) to <sshGitHub> port 22 flags S/SA keep state

# SSH (local, wired-only)
#pass out on $wired proto tcp from ($wired) to <sshLocal> port 22 flags S/SA keep state

# Outbound ICMP (ping)
#pass out on $wifi  proto icmp  from ($wifi)  to any keep state
#pass out on $wired proto icmp  from ($wired) to any keep state
#pass out on $wifi  proto icmp6 from ($wifi)  to any keep state
#pass out on $wired proto icmp6 from ($wired) to any keep state
